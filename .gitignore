# ==================== 编译产物（精准匹配项目路径）====================
# 安卓动态库输出目录（so实际存放位置）
eleeye/jniLibs/
# 其他编译输出目录
BIN/
# 象眼引擎编译中间文件
eleeye/*.o
eleeye/*.bak
# 临时备份/日志文件
*.bak
*.log
*.tmp
*.so
*.a

# ==================== 本地环境配置（不共享）====================
# 本地编译脚本（不同机器NDK路径不同）
*.sh
# 安卓本地NDK配置
local.properties

# ==================== IDE配置（个人开发环境，不共享）====================
# Eclipse配置
.project
.settings/
# VS Code配置
.vscode/
# CLion配置
.idea/